{
  "RabbitMcp": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "ClientName": "rabbit-mcp",
    "EnablePublish": false,
    "EnableRepublish": false,
    "MaxMessagesPerCall": 50,
    "MaxPayloadChars": 16000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
