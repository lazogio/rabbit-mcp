<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared message contracts. This project has no dependencies, so the same
    assembly can be referenced by the MCP server and by your services
    (MassTransit consumers, plain RabbitMQ.Client consumers, etc.).
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>RabbitMcp.Contracts</PackageId>
    <Description>[MessageContract] attribute for rabbit-mcp contract assemblies: every contract becomes a typed MCP tool for RabbitMQ / MassTransit.</Description>
    <Authors>lazogio</Authors>
    <PackageTags>rabbitmq;masstransit;mcp;contracts;messaging</PackageTags>
    <PackageProjectUrl>https://github.com/lazogio/rabbit-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lazogio/rabbit-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      Fixed assembly version: contract DLLs compiled against any 1.x package bind to whatever
      RabbitMcp.Contracts the server ships with. Only change on a breaking attribute change.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
</Project>
