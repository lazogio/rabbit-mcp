<Project Sdk="Microsoft.NET.Sdk">
  <!-- A MassTransit 8 service (plus one plain RabbitMQ.Client worker): the "real" side that rabbit-mcp talks to in the sample. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- ShippingDesk talks to RabbitMQ directly, without MassTransit. -->
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shop.Contracts\Shop.Contracts.csproj" />
  </ItemGroup>
</Project>
